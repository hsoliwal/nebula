<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.eclipse.nebula</groupId>
	<artifactId>nebula-root</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<modules>
		<module>releng/org.eclipse.nebula.nebula-parent</module>
	</modules>


	<profiles>
		<profile>
			<!--
				Opt-in M3 source-model distillation. The ordinary Nebula Tycho reactor
				remains authoritative. This profile only runs the canonical Synexia
				read-only repository atom/pattern second-pass recipe and exports evidence.

				Install com.synexia:synexia-openrewrite-recipes:1.0.0-SNAPSHOT first.
				For second-pass proof, that SNAPSHOT must come from the exact binding recorded in
				m3/catalogue/second-pass-recipe-binding.tsv; an arbitrary SNAPSHOT is not equivalent.
				then run:
				  mvn -Pm3-atomize-patternize rewrite:dryRunNoFork
			-->
			<id>m3-atomize-patternize</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.openrewrite.maven</groupId>
						<artifactId>rewrite-maven-plugin</artifactId>
						<version>5.23.1</version>
						<configuration>
							<failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
							<failOnDryRunResults>false</failOnDryRunResults>
							<exportDatatables>true</exportDatatables>
							<activeRecipes>
								<recipe>com.synexia.rewrite.M3AtomPatternSignalChainRecipe</recipe>
							</activeRecipes>
						</configuration>
						<dependencies>
							<dependency>
								<groupId>com.synexia</groupId>
								<artifactId>synexia-openrewrite-recipes</artifactId>
								<version>1.0.0-SNAPSHOT</version>
							</dependency>
						</dependencies>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!--
				Read-only full M3 second-pass review DAG pinned by
				m3/catalogue/second-pass-review-dag-binding.tsv.

				Install m3/recipe-first plus the exact pinned Synexia recipe artifact first,
				then run:
				  mvn -Pm3-second-pass-review-dag rewrite:dryRunNoFork

				The profile is opt-in, performs no lifecycle-bound rewrite goal, and grants
				no source mutation, semantic-equivalence, native-execution or promotion authority.
			-->
			<id>m3-second-pass-review-dag</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.openrewrite.maven</groupId>
						<artifactId>rewrite-maven-plugin</artifactId>
						<version>6.46.1</version>
						<configuration>
							<failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
							<failOnDryRunResults>false</failOnDryRunResults>
							<exportDatatables>true</exportDatatables>
							<activeRecipes>
								<recipe>org.eclipse.nebula.m3.SecondPassReviewDag</recipe>
							</activeRecipes>
						</configuration>
						<dependencies>
							<dependency>
								<groupId>org.eclipse.nebula.m3</groupId>
								<artifactId>nebula-m3-recipe-first</artifactId>
								<version>1.0.0-SNAPSHOT</version>
							</dependency>
							<dependency>
								<groupId>com.synexia</groupId>
								<artifactId>synexia-openrewrite-recipes</artifactId>
								<version>1.0.0-SNAPSHOT</version>
							</dependency>
						</dependencies>
					</plugin>
				</plugins>
			</build>
		</profile>


		<profile>
			<!--
				Canonical Synexia-owned FILE convergence recipe proven first in Nebula.
				Install the exact bound com.synexia:synexia-openrewrite-recipes SNAPSHOT
				from m3/catalogue/pure-int-recipe-binding.tsv, then run explicitly:
				  mvn -Pm3-local-file-convergence rewrite:dryRunNoFork

				The historical Nebula-local pure-int recipes remain proving fixtures only.
				Source mutation stays candidate-only and promotion authority remains false.
			-->
			<id>m3-local-file-convergence</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.openrewrite.maven</groupId>
						<artifactId>rewrite-maven-plugin</artifactId>
						<version>6.46.1</version>
						<configuration>
							<failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
							<failOnDryRunResults>false</failOnDryRunResults>
							<exportDatatables>true</exportDatatables>
							<activeRecipes>
								<recipe>com.synexia.rewrite.M3PureIntConvergenceRecipe</recipe>
							</activeRecipes>
						</configuration>
						<dependencies>
							<dependency>
								<groupId>com.synexia</groupId>
								<artifactId>synexia-openrewrite-recipes</artifactId>
								<version>1.0.0-SNAPSHOT</version>
							</dependency>
						</dependencies>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!--
				FILE-local compatibility migration for the current Eclipse CSS value
				model. This is intentionally separate from the generic atomize/patternize
				DAG. Build/install m3/recipe-first first, then run:
				  mvn -Pm3-cdatetime-css-compat rewrite:runNoFork

				OpenRewrite ChangeType is the reviewed stock donor for the mechanical
				Measure type migration; the source-sealed recipe additionally preserves
				Nebula's historical font-shorthand classification behavior.
			-->
			<id>m3-cdatetime-css-compat</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.openrewrite.maven</groupId>
						<artifactId>rewrite-maven-plugin</artifactId>
						<version>6.46.1</version>
						<configuration>
							<failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
							<activeRecipes>
								<recipe>org.eclipse.nebula.m3.CDateTimeCssCompatibility</recipe>
							</activeRecipes>
						</configuration>
						<dependencies>
							<dependency>
								<groupId>org.eclipse.nebula.m3</groupId>
								<artifactId>nebula-m3-recipe-first</artifactId>
								<version>1.0.0-SNAPSHOT</version>
							</dependency>
						</dependencies>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>m3-local-repository-review</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.openrewrite.maven</groupId>
						<artifactId>rewrite-maven-plugin</artifactId>
						<version>6.46.1</version>
						<configuration>
							<failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
							<failOnDryRunResults>false</failOnDryRunResults>
							<exportDatatables>true</exportDatatables>
							<activeRecipes>
								<recipe>org.eclipse.nebula.m3.RepositoryReview</recipe>
							</activeRecipes>
						</configuration>
						<dependencies>
							<dependency>
								<groupId>org.eclipse.nebula.m3</groupId>
								<artifactId>nebula-m3-recipe-first</artifactId>
								<version>1.0.0-SNAPSHOT</version>
							</dependency>
						</dependencies>
					</plugin>
				</plugins>
			</build>
		</profile>


		<profile>
			<!-- Exact FILE-local final upstream-sync leaf. Build/install m3/recipe-first first. -->
			<id>m3-final-upstream-sync</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.openrewrite.maven</groupId>
						<artifactId>rewrite-maven-plugin</artifactId>
						<version>6.46.1</version>
						<configuration>
							<failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
							<activeRecipes>
								<recipe>org.eclipse.nebula.m3.UpstreamSyncIgnore</recipe>
							</activeRecipes>
						</configuration>
						<dependencies>
							<dependency>
								<groupId>org.eclipse.nebula.m3</groupId>
								<artifactId>nebula-m3-recipe-first</artifactId>
								<version>1.0.0-SNAPSHOT</version>
							</dependency>
						</dependencies>
					</plugin>
				</plugins>
			</build>
		</profile>

	</profiles>

</project>