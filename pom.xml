<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.eclipse.nebula</groupId>
	<artifactId>nebula-root</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<properties>
		<synexia.rewrite.repository>hsoliwal/nebula</synexia.rewrite.repository>
		<synexia.rewrite.project>nebula</synexia.rewrite.project>
		<synexia.rewrite.module>${project.artifactId}</synexia.rewrite.module>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.openrewrite.maven</groupId>
				<artifactId>rewrite-maven-plugin</artifactId>
				<version>6.27.0</version>
				<configuration>
					<activeRecipes>
						<recipe>com.synexia.fleet.AtomizeAndPatternize</recipe>
					</activeRecipes>
					<configLocation>${maven.multiModuleProjectDirectory}/rewrite.yml</configLocation>
					<resolvePropertiesInYaml>true</resolvePropertiesInYaml>
					<exportDatatables>true</exportDatatables>
					<runPerSubmodule>true</runPerSubmodule>
					<failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
					<exclusions>
						<exclusion>.rewrite/**</exclusion>
						<exclusion>**/.rewrite/**</exclusion>
						<exclusion>target/**</exclusion>
						<exclusion>**/target/**</exclusion>
					</exclusions>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>com.synexia.recipe</groupId>
						<artifactId>synexia-atom-pattern-recipes-candidate</artifactId>
						<version>20261004-source871</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

	<modules>
		<module>releng/org.eclipse.nebula.nebula-parent</module>
	</modules>

</project>