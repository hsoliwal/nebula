<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- Deliberately no parent: this lane compiles the real bounded source closure, not the entire reactor. -->
  <groupId>com.synexia.verification</groupId>
  <artifactId>donor-assimilation-verification</artifactId>
  <version>${revision}</version>
  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rewrite.version>8.17.1</rewrite.version>
    <junit.version>5.10.2</junit.version>
  </properties>
  <dependencies>
    <!-- The embedding runtime supplies logging; rewrite-core does not publish it transitively. -->
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>1.7.36</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-core</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-java-21</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-maven</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-xml</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.openrewrite</groupId><artifactId>rewrite-yaml</artifactId><version>${rewrite.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.basedir}/../../..</sourceDirectory>
    <resources>
      <resource><directory>${project.basedir}/../../src/main/resources</directory>
        <includes>
          <include>META-INF/rewrite/m3-donor-assimilation.yml</include>
          <include>META-INF/rewrite/m3-nebula-donor-assimilation.yml</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
        <configuration>
          <parameters>true</parameters><proc>none</proc>
          <includes>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3DonorMavenBootstrapRecipe.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3AddMavenPluginIfMissingRecipe.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3DonorAssimilationRecipe.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3NebulaDonorAssimilationRecipe.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3EditScope.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3CanonicalMultiPassPlan.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3RecipeFirstJavaAtomInventoryRecipe.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3RecipeFirstJavaAtomInventoryTable.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3RecipeFirstSourceCoverageTable.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3SourceKind.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3FrameworkRecipePatternReviewRecipe.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3FrameworkRecipePatternCatalog.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3MechanicalDonorShapeReviewRecipe.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3MechanicalDonorShapeReview.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/M3MechanicalJavaRecipe.java</include>
            <include>synexia-openrewrite-recipes/src/main/java/com/synexia/rewrite/sealed/SealHash.java</include>
            <include>synexia-donor-inventory/src/main/java/com/synexia/donor/DonorMechanicalShapeCatalog.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
        <configuration><failIfNoTests>true</failIfNoTests><useModulePath>false</useModulePath></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.1.2</version></plugin>
      <plugin><groupId>org.openrewrite.maven</groupId><artifactId>rewrite-maven-plugin</artifactId><version>5.23.1</version></plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>nebula-proof-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>nebula-proof-report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>nebula-proof-check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes>
                <include>com/synexia/rewrite/M3NebulaDonorAssimilationRecipe*</include>
                <include>com/synexia/rewrite/M3EditScope*</include>
                <include>com/synexia/rewrite/M3CanonicalMultiPassPlan*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.99</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.99</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>repair-bootstrap</id>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.3.0</version>
        <executions><execution><id>source-sealed-bootstrap-repair</id><phase>validate</phase><goals><goal>exec</goal></goals>
          <configuration><executable>${java.home}/bin/java</executable><arguments>
            <argument>${project.basedir}/RepairBootstrap.java</argument>
            <argument>${project.basedir}/../../..</argument><argument>--apply</argument>
          </arguments></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
