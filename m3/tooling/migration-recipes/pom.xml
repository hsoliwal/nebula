<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.eclipse.nebula.m3</groupId>
    <artifactId>nebula-m3-control</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>migration-recipes</artifactId>
  <name>Nebula M3 migration recipes</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rewrite.version>8.17.1</rewrite.version>
    <m3.convergence.skip>true</m3.convergence.skip>
    <m3.nebula.root>${project.basedir}/../../..</m3.nebula.root>
    <m3.convergence.output>${project.build.directory}/m3-nebula-source-convergence</m3.convergence.output>
    <m3.convergence.threads>4</m3.convergence.threads>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java</artifactId>
      <version>${rewrite.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-java-21</artifactId>
      <version>${rewrite.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.openrewrite</groupId>
      <artifactId>rewrite-test</artifactId>
      <version>${rewrite.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration><useModulePath>false</useModulePath><failIfNoTests>true</failIfNoTests></configuration>
      </plugin>
      <plugin>
        <groupId>org.openrewrite.maven</groupId>
        <artifactId>rewrite-maven-plugin</artifactId>
        <version>5.23.1</version>
        <configuration>
          <exportDatatables>true</exportDatatables>
          <failOnInvalidActiveRecipes>true</failOnInvalidActiveRecipes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <executions>
          <execution>
            <id>m3-nebula-source-convergence</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <skip>${m3.convergence.skip}</skip>
              <mainClass>com.m3.rewrite.convergence.M3NebulaSourceConvergenceMain</mainClass>
              <arguments>
                <argument>${m3.nebula.root}</argument>
                <argument>${m3.convergence.output}</argument>
                <argument>${m3.convergence.threads}</argument>
              </arguments>
              <cleanupDaemonThreads>false</cleanupDaemonThreads>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>m3-nebula-source-convergence</id>
      <properties><m3.convergence.skip>false</m3.convergence.skip></properties>
    </profile>
  </profiles>
</project>
