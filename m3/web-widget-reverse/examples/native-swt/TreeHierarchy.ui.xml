    <g:Label ui:field="title" text="Archive &amp; tools"/>
    <g:Tree ui:field="folders">
      <g:TreeItem ui:field="root" text="Projects &amp; files" expanded="true">
        <g:TreeItem ui:field="docs" text="Documents">
          <g:TreeItem text="Report.txt"/>
        </g:TreeItem>
        <g:TreeItem text="Images"/>
